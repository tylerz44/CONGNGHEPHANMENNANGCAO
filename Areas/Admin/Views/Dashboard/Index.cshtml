@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .admin-dashboard {
        background: #f5f7fb;
        min-height: 75vh;
        padding: 35px 0;
    }

    .admin-header {
        background: linear-gradient(135deg, #212529, #343a40);
        color: white;
        padding: 30px;
        border-radius: 15px;
        margin-bottom: 30px;
    }

        .admin-header h2 {
            font-weight: 700;
        }

    .admin-card {
        background: white;
        border: none;
        border-radius: 15px;
        padding: 25px;
        height: 100%;
        box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        transition: 0.25s;
    }

        .admin-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.12);
        }

    .admin-icon {
        width: 60px;
        height: 60px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 18px;
    }

    .admin-card h5 {
        font-weight: 700;
        margin-bottom: 10px;
    }

    .admin-card p {
        color: #6c757d;
        min-height: 48px;
    }

    .admin-card .btn {
        border-radius: 8px;
        font-weight: 600;
    }

    .icon-blue {
        background: #e7f1ff;
        color: #0d6efd;
    }

    .icon-green {
        background: #e5f7ed;
        color: #198754;
    }

    .icon-orange {
        background: #fff0df;
        color: #fd7e14;
    }

    .icon-purple {
        background: #f0e9ff;
        color: #6f42c1;
    }

    .admin-section-title {
        font-weight: 700;
        margin-bottom: 20px;
        }
</style>

<div class="admin-dashboard">
    <div class="container">

        <!-- HEADER -->
        <div class="admin-header">
            <div class="d-flex flex-column flex-md-row
                        justify-content-between align-items-md-center">

                <div>
                    <h2>
                        <i class="bi bi-speedometer2 text-warning"></i>
                        QUẢN TRỊ HỆ THỐNG TECHMARKET
                    </h2>

                    <p class="mb-0 text-white-50">
                        Chào mừng bạn đến với trung tâm quản trị TechMarket.
                    </p>
                </div>

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-light mt-3 mt-md-0">
                    <i class="bi bi-house-door"></i>
                    Về trang chủ
                </a>

            </div>
        </div>

        <!-- MANAGEMENT -->
        <h4 class="admin-section-title">
            <i class="bi bi-grid-fill text-primary"></i>
            Quản lý hệ thống
        </h4>

        <div class="row g-4">

            <!-- USERS -->
            <div class="col-md-6 col-lg-4">
                <div class="admin-card">

                    <div class="admin-icon icon-blue">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <h5>Quản lý người dùng</h5>

                    <p>
                        Xem và quản lý tài khoản khách hàng trên hệ thống.
                    </p>

                    <a asp-area="Admin"
                       asp-controller="User"
                       asp-action="Index"
                       class="btn btn-primary w-100">
                        <i class="bi bi-arrow-right-circle"></i>
                        Quản lý người dùng
                    </a>

                </div>
            </div>

            <!-- STORE OWNER APPROVAL -->
            <div class="col-md-6 col-lg-4">
                <div class="admin-card">

                    <div class="admin-icon icon-orange">
                        <i class="bi bi-person-check-fill"></i>
                    </div>

                    <h5>Duyệt yêu cầu mở cửa hàng</h5>

                    <p>
                        Xem xét yêu cầu và xác nhận tài khoản được cấp quyền
                        StoreOwner.
                    </p>

                    <a asp-area="Admin"
                       asp-controller="StoreApproval"
                       asp-action="Index"
                       class="btn btn-warning w-100">
                        <i class="bi bi-check-circle"></i>
                        Xét duyệt yêu cầu
                    </a>

                </div>
            </div>

            <!-- STORES -->
            <div class="col-md-6 col-lg-4">
                <div class="admin-card">

                    <div class="admin-icon icon-green">
                        <i class="bi bi-shop"></i>
                    </div>

                    <h5>Quản lý cửa hàng</h5>

                    <p>
                        Theo dõi danh sách cửa hàng đã đăng ký và được duyệt.
                    </p>

                    <a asp-area="Admin"
                       asp-controller="Store"
                       asp-action="Index"
                       class="btn btn-success w-100">
                        <i class="bi bi-arrow-right-circle"></i>
                        Quản lý cửa hàng
                    </a>

                </div>
            </div>

            <!-- PRODUCTS -->
            <div class="col-md-6 col-lg-4">
                <div class="admin-card">

                    <div class="admin-icon icon-purple">
                        <i class="bi bi-box-seam"></i>
                    </div>

                    <h5>Quản lý sản phẩm</h5>

                    <p>
                        Kiểm soát các sản phẩm được đăng bán trên TechMarket.
                    </p>

                    <a asp-area="Admin"
                       asp-controller="Product"
                       asp-action="Index"
                       class="btn btn-dark w-100">
                        <i class="bi bi-arrow-right-circle"></i>
                        Quản lý sản phẩm
                    </a>

                </div>
            </div>

            <!-- CATEGORIES -->
            <div class="col-md-6 col-lg-4">
                <div class="admin-card">

                    <div class="admin-icon icon-blue">
                        <i class="bi bi-tags-fill"></i>
                    </div>

                    <h5>Quản lý danh mục</h5>

                    <p>
                        Thêm, sửa và quản lý danh mục sản phẩm.
                    </p>

                    <a asp-area="Admin"
                       asp-controller="Category"
                       asp-action="Index"
                       class="btn btn-primary w-100">
                        <i class="bi bi-arrow-right-circle"></i>
                        Quản lý danh mục
                    </a>

                </div>
            </div>

        </div>

        <!-- FOOTER NOTE -->
        <div class="mt-4 p-3 bg-white rounded-3 shadow-sm">
            <div class="d-flex align-items-center">
                <i class="bi bi-shield-lock-fill text-success fs-4 me-3"></i>

                <div>
                    <strong>Khu vực quản trị viên</strong>
                    <div class="text-muted small">
                        Chỉ tài khoản có quyền Admin mới được phép truy cập.
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
