@model TechMarket.ViewModels.EditProductViewModel

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container mt-4 mb-5">

    <h2 class="mb-4">Chỉnh sửa sản phẩm</h2>

    <form asp-area="Store"
          asp-controller="Product"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <!-- Tên sản phẩm -->
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control"
                   placeholder="Nhập tên sản phẩm" />
            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <!-- Mô tả -->
        <div class="mb-3">
            <label asp-for="Description"
                   class="form-label"></label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"
                      placeholder="Mô tả sản phẩm"></textarea>
            <span asp-validation-for="Description"
                  class="text-danger"></span>
        </div>

        <!-- Danh mục -->
        <div class="mb-3">
            <label asp-for="CategoryId"
                   class="form-label"></label>

            <select asp-for="CategoryId"
                    asp-items="Model.Categories"
                    class="form-select">
                <option value="">-- Chọn danh mục --</option>
            </select>

            <span asp-validation-for="CategoryId"
                  class="text-danger"></span>
        </div>

        <!-- Giá và số lượng -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Price"
                       class="form-label"></label>

                <input asp-for="Price"
                       type="number"
                       step="0.01"
                       min="0.01"
                       class="form-control" />

                <span asp-validation-for="Price"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Quantity"
                       class="form-label"></label>

                <input asp-for="Quantity"
                       type="number"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="Quantity"
                      class="text-danger"></span>
            </div>
        </div>

        <!-- Kích cỡ và màu sắc -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Size"
                       class="form-label"></label>

                <input asp-for="Size"
                       class="form-control"
                       placeholder="S, M, L, XL" />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Color"
                       class="form-label"></label>

                <input asp-for="Color"
                       class="form-control"
                       placeholder="Đen, Trắng, Xanh" />
            </div>
        </div>

        <!-- Ảnh hiện tại -->
        <div class="mb-3">
            <label class="form-label">Ảnh hiện tại</label>

            @if (!string.IsNullOrEmpty(Model.CurrentImageUrl))
            {
                <div>
                    <img src="@Model.CurrentImageUrl"
                         alt="Ảnh sản phẩm"
                         style="width:180px;height:180px;object-fit:cover;"
                         class="rounded border" />
                </div>
            }
            else
            {
                <p class="text-muted">Sản phẩm chưa có ảnh.</p>
            }
        </div>

        <!-- Chọn ảnh mới -->
        <div class="mb-4">
            <label asp-for="ImageFile"
                   class="form-label"></label>

            <input asp-for="ImageFile"
                   type="file"
                   accept=".jpg,.jpeg,.png,.webp"
                   class="form-control" />

            <span asp-validation-for="ImageFile"
                  class="text-danger"></span>

            <small class="text-muted">
                Nếu không chọn ảnh mới, hệ thống sẽ giữ ảnh hiện tại.
                Hỗ trợ JPG, JPEG, PNG, WEBP. Tối đa 5 MB.
            </small>
        </div>

        <!-- Nút chức năng -->
        <button type="submit" class="btn btn-primary">
            Lưu thay đổi
        </button>

        <a asp-area="Store"
           asp-controller="Product"
           asp-action="Index"
           class="btn btn-secondary">
            Quay lại
        </a>

    </form>
</div>
