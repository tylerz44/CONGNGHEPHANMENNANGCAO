@model TechMarket.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";

    var details = Model.OrderDetails ?? new List<TechMarket.Models.OrderDetail>();

    var storeOrder = ViewBag.StoreOrder as TechMarket.Models.StoreOrder;

    string currentStatus = storeOrder?.Status ?? "Chưa xác định";

    decimal storeTotal = details.Sum(d => d.TotalPrice);
    int totalQuantity = details.Sum(d => d.Quantity);

    bool canCancel = currentStatus == "Chờ xác nhận"
                  || currentStatus == "Đang giao hàng";

    string statusClass = currentStatus switch
    {
        "Chờ xác nhận" => "status-pending",
        "Đang giao hàng" => "status-shipping",
        "Đã giao hàng" => "status-completed",
        "Đã hủy" => "status-cancelled",
        _ => "status-unknown"
    };

    string statusIcon = currentStatus switch
    {
        "Chờ xác nhận" => "bi-clock-history",
        "Đang giao hàng" => "bi-truck",
        "Đã giao hàng" => "bi-check-circle",
        "Đã hủy" => "bi-x-circle",
        _ => "bi-question-circle"
    };
}

<style>
    .detail-page {
        background: #f8fafc;
        min-height: 100vh;
        padding: 25px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

    .page-title {
        font-size: 27px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 5px;
    }

    .page-subtitle {
        color: #64748b;
        margin: 0;
    }

    .btn-back {
        background: white;
        border: 1px solid #cbd5e1;
        padding: 10px 17px;
        border-radius: 8px;
        text-decoration: none;
        color: #334155;
        font-weight: 600;
        transition: .2s;
    }

        .btn-back:hover {
            background: #f1f5f9;
            color: #1e293b;
        }

    .order-code-card {
        background: linear-gradient(120deg, #1d4ed8, #2563eb);
        color: white;
        padding: 23px;
        border-radius: 13px;
        margin-bottom: 22px;
        box-shadow: 0 5px 15px rgba(37, 99, 235, .15);
    }

        .order-code-card h3 {
            font-weight: 700;
            margin-bottom: 7px;
        }

        .order-code-card p {
            margin: 0;
            opacity: .85;
        }

    .order-code-info {
        text-align: right;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 13px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 700;
    }

    .status-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .status-shipping {
        background: #ede9fe;
        color: #6d28d9;
    }

    .status-completed {
        background: #dcfce7;
        color: #166534;
    }

    .status-cancelled {
        background: #fee2e2;
        color: #991b1b;
    }

    .status-unknown {
        background: #e2e8f0;
        color: #475569;
    }

    .info-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        margin-bottom: 22px;
        overflow: hidden;
    }

    .info-card-header {
        padding: 17px 20px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #1e293b;
        font-weight: 700;
        font-size: 16px;
    }

        .info-card-header i {
            color: #2563eb;
            font-size: 19px;
        }

    .info-card-body {
        padding: 22px;
    }

    .info-label {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .info-value {
        color: #1e293b;
        font-weight: 600;
        font-size: 14px;
        overflow-wrap: anywhere;
    }

    .info-item {
        margin-bottom: 20px;
    }

        .info-item:last-child {
            margin-bottom: 0;
        }

    .product-table {
        width: 100%;
        border-collapse: collapse;
        white-space: nowrap;
    }

        .product-table thead {
            background: #f8fafc;
        }

        .product-table th {
            color: #64748b;
            font-size: 12px;
            text-transform: uppercase;
            padding: 15px;
            border-bottom: 1px solid #e2e8f0;
        }

        .product-table td {
            padding: 17px 15px;
            border-bottom: 1px solid #f1f5f9;
            color: #334155;
            font-size: 14px;
            vertical-align: middle;
        }

    .product-name {
        color: #1e293b;
        font-weight: 700;
    }

    .product-meta {
        color: #64748b;
        font-size: 12px;
        margin-top: 5px;
    }

    .product-price {
        color: #334155;
        font-weight: 600;
    }

    .product-total {
        color: #dc2626;
        font-weight: 700;
    }

    .summary-box {
        background: #f8fafc;
        border-radius: 10px;
        padding: 20px;
        margin-top: 20px;
        margin-left: auto;
        max-width: 390px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 12px;
        color: #64748b;
        font-size: 14px;
    }

    .summary-total {
        border-top: 1px solid #e2e8f0;
        padding-top: 15px;
        margin-top: 12px;
        margin-bottom: 0;
        color: #1e293b;
        font-size: 16px;
        font-weight: 700;
    }

        .summary-total strong {
            color: #dc2626;
            font-size: 21px;
        }

    .update-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        margin-bottom: 22px;
        overflow: hidden;
    }

    .update-card-body {
        padding: 22px;
    }

    .status-select {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 11px 13px;
        width: 100%;
        outline: none;
    }

        .status-select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .1);
        }

    .btn-update {
        background: #2563eb;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 11px 20px;
        font-weight: 600;
        transition: .2s;
    }

        .btn-update:hover {
            background: #1d4ed8;
            color: white;
        }

    .btn-cancel-order {
        background: white;
        color: #dc2626;
        border: 1px solid #dc2626;
        border-radius: 8px;
        padding: 11px 20px;
        font-weight: 600;
        transition: .2s;
    }

        .btn-cancel-order:hover {
            background: #dc2626;
            color: white;
        }

    .note-box {
        background: #fffbeb;
        border: 1px solid #fde68a;
        padding: 15px;
        border-radius: 9px;
        color: #92400e;
        font-size: 14px;
    }

    .empty-products {
        text-align: center;
        padding: 35px;
        color: #64748b;
    }

    @@media (max-width: 768px) {
        .detail-page {
            padding: 15px;
        }

        .page-title {
            font-size: 22px;
        }

        .order-code-info {
            text-align: left;
            margin-top: 15px;
        }

        .summary-box {
            max-width: 100%;
        }
    }
</style>

<div class="detail-page">

    <!-- HEADER -->
    <div class="page-header">
        <div>
            <h2 class="page-title">
                <i class="bi bi-receipt me-2"></i>
                Chi tiết đơn hàng
            </h2>

            <p class="page-subtitle">
                Xem thông tin và quản lý đơn hàng của cửa hàng.
            </p>
        </div>

        <a asp-area="Store"
           asp-controller="Order"
           asp-action="Index"
           class="btn-back">
            <i class="bi bi-arrow-left me-2"></i>
            Quay lại danh sách
        </a>
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-circle-fill me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- ORDER HEADER -->
    <div class="order-code-card">
        <div class="row align-items-center">
            <div class="col-md-7">
                <h3>
                    Đơn hàng #TM-@Model.Id.ToString("D5")
                </h3>

                <p>
                    <i class="bi bi-calendar3 me-2"></i>
                    Đặt ngày @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </p>
            </div>

            <div class="col-md-5 order-code-info">
                <div class="mb-2">
                    <span class="opacity-75">Trạng thái cửa hàng</span>
                </div>

                <span class="status-badge @statusClass">
                    <i class="bi @statusIcon"></i>
                    @currentStatus
                </span>
            </div>
        </div>
    </div>

    <!-- CUSTOMER INFORMATION -->
    <div class="row">

        <div class="col-lg-7">

            <div class="info-card">

                <div class="info-card-header">
                    <i class="bi bi-person-circle"></i>
                    Thông tin khách hàng
                </div>

                <div class="info-card-body">

                    <div class="row">

                        <div class="col-md-6 info-item">
                            <div class="info-label">Người nhận</div>
                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.ReceiverName)
                                    ? "Chưa có thông tin"
                                    : Model.ReceiverName)
                            </div>
                        </div>

                        <div class="col-md-6 info-item">
                            <div class="info-label">Số điện thoại</div>
                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.Phone)
                                    ? "Chưa có thông tin"
                                    : Model.Phone)
                            </div>
                        </div>

                        <div class="col-12 info-item">
                            <div class="info-label">Địa chỉ giao hàng</div>
                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.ShippingAddress)
                                    ? "Chưa có thông tin"
                                    : Model.ShippingAddress)
                            </div>
                        </div>

                        <div class="col-md-6 info-item">
                            <div class="info-label">Phương thức thanh toán</div>
                            <div class="info-value">
                                @if (Model.PaymentMethod == "COD")
                                {
                                    <span>
                                        <i class="bi bi-cash-coin text-success me-1"></i>
                                        Thanh toán khi nhận hàng
                                    </span>
                                }
                                else
                                {
                                    @Model.PaymentMethod
                                }
                            </div>
                        </div>

                        <div class="col-md-6 info-item">
                            <div class="info-label">Mã đơn hàng</div>
                            <div class="info-value">
                                #TM-@Model.Id.ToString("D5")
                            </div>
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Note))
                    {
                        <div class="note-box mt-2">
                            <strong>
                                <i class="bi bi-chat-left-text me-2"></i>
                                Ghi chú của khách hàng
                            </strong>

                            <div class="mt-2">
                                @Model.Note
                            </div>
                        </div>
                    }

                </div>
            </div>

        </div>

        <!-- ORDER STATUS -->
        <div class="col-lg-5">

            <div class="update-card">

                <div class="info-card-header">
                    <i class="bi bi-arrow-repeat"></i>
                    Quản lý trạng thái đơn hàng
                </div>

                <div class="update-card-body">

                    @if (storeOrder != null)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Trạng thái hiện tại
                            </label>

                            <div>
                                <span class="status-badge @statusClass">
                                    <i class="bi @statusIcon"></i>
                                    @currentStatus
                                </span>
                            </div>
                        </div>

                        @if (canCancel)
                        {
                            <!-- FORM CẬP NHẬT TRẠNG THÁI -->
                            <form asp-area="Store"
                                  asp-controller="Order"
                                  asp-action="UpdateStatus"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@storeOrder.Id" />

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">
                                        Chọn trạng thái mới
                                    </label>

                                    <select name="status"
                                            class="status-select"
                                            required>

                                        <option value="Chờ xác nhận"
                                                selected="@(currentStatus == "Chờ xác nhận")">
                                            Chờ xác nhận
                                        </option>

                                        <option value="Đang giao hàng"
                                                selected="@(currentStatus == "Đang giao hàng")">
                                            Đang giao hàng
                                        </option>

                                        <option value="Đã giao hàng">
                                            Đã giao hàng
                                        </option>

                                    </select>
                                </div>

                                <button type="submit" class="btn-update w-100">
                                    <i class="bi bi-check-circle me-2"></i>
                                    Cập nhật trạng thái
                                </button>

                            </form>

                            <hr class="my-4" />

                            <!-- FORM HỦY ĐƠN -->
                            <form asp-area="Store"
                                  asp-controller="Order"
                                  asp-action="Cancel"
                                  asp-route-id="@Model.Id"
                                  method="post"
                                  onsubmit="return confirm('Bạn có chắc chắn muốn hủy phần đơn hàng thuộc cửa hàng của mình không? Số lượng sản phẩm sẽ được hoàn lại kho.');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn-cancel-order w-100">
                                    <i class="bi bi-x-circle me-2"></i>
                                    Hủy đơn hàng
                                </button>

                            </form>
                        }
                        else if (currentStatus == "Đã giao hàng")
                        {
                            <div class="alert alert-success mb-0">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                Đơn hàng đã giao thành công. Không thể hủy hoặc cập nhật trạng thái.
                            </div>
                        }
                        else if (currentStatus == "Đã hủy")
                        {
                            <div class="alert alert-danger mb-0">
                                <i class="bi bi-x-circle-fill me-2"></i>
                                Đơn hàng của cửa hàng đã được hủy.
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            Không tìm thấy thông tin liên kết đơn hàng với cửa hàng.
                        </div>
                    }

                </div>
            </div>

            <!-- QUICK INFORMATION -->
            <div class="info-card">

                <div class="info-card-header">
                    <i class="bi bi-clipboard-data"></i>
                    Tổng quan đơn hàng
                </div>

                <div class="info-card-body">

                    <div class="summary-row">
                        <span>Số loại sản phẩm</span>
                        <strong>@details.Count</strong>
                    </div>

                    <div class="summary-row">
                        <span>Tổng số lượng</span>
                        <strong>@totalQuantity</strong>
                    </div>

                    <div class="summary-row">
                        <span>Thanh toán</span>
                        <strong>@Model.PaymentMethod</strong>
                    </div>

                    <div class="summary-row summary-total">
                        <span>Tổng tiền cửa hàng</span>
                        <strong>@storeTotal.ToString("N0") đ</strong>
                    </div>

                </div>
            </div>

        </div>

    </div>

    <!-- PRODUCT LIST -->
    <div class="info-card">

        <div class="info-card-header">
            <i class="bi bi-bag-check"></i>
            Sản phẩm thuộc cửa hàng của bạn
            <span class="badge bg-primary ms-auto">
                @details.Count sản phẩm
            </span>
        </div>

        <div class="info-card-body">

            <div class="table-responsive">

                @if (details.Any())
                {
                    <table class="product-table">

                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>SKU</th>
                                <th>Size</th>
                                <th>Màu sắc</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in details)
                            {
                                <tr>

                                    <td>
                                        <div class="product-name">
                                            @item.ProductName
                                        </div>

                                        <div class="product-meta">
                                            Mã sản phẩm: @item.ProductId
                                        </div>
                                    </td>

                                    <td>
                                        <span class="text-muted">
                                            @item.SKU
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @item.Size
                                        </span>
                                    </td>

                                    <td>
                                        @item.Color
                                    </td>

                                    <td>
                                        <span class="product-price">
                                            @item.UnitPrice.ToString("N0") đ
                                        </span>
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @item.Quantity
                                        </span>
                                    </td>

                                    <td>
                                        <span class="product-total">
                                            @item.TotalPrice.ToString("N0") đ
                                        </span>
                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>
                }
                else
                {
                    <div class="empty-products">
                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                        <strong>Không có sản phẩm trong đơn hàng</strong>
                    </div>
                }

            </div>

            @if (details.Any())
            {
                <div class="summary-box">

                    <div class="summary-row">
                        <span>Tổng số lượng sản phẩm</span>
                        <strong>@totalQuantity</strong>
                    </div>

                    <div class="summary-row summary-total">
                        <span>Tổng thanh toán</span>
                        <strong>@storeTotal.ToString("N0") đ</strong>
                    </div>

                </div>
            }

        </div>
    </div>

</div>
