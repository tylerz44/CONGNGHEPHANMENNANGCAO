@model List<TechMarket.Models.Order>

@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<div class="container mt-4 mb-5">
    <h2 class="mb-4">Lịch sử đơn hàng</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <h5>Bạn chưa có đơn hàng nào.</h5>

            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-primary mt-3">
                Tiếp tục mua sắm
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Số sản phẩm</th>
                        <th>Tổng tiền</th>
                        <th>Thanh toán</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="OrderHistory"
                                   asp-action="Details"
                                   asp-route-id="@order.Id"
                                   class="text-decoration-none fw-bold">
                                    #@order.Id
                                </a>
                            </td>

                            <td>
                                @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @order.OrderDetails.Sum(d => d.Quantity)
                            </td>

                            <td class="text-danger fw-bold">
                                @order.TotalAmount.ToString("N0") đ
                            </td>

                            <td>
                                @if (order.PaymentMethod == "COD")
                                {
                                    <span>Thanh toán khi nhận hàng</span>
                                }
                                else
                                {
                                    @order.PaymentMethod
                                }
                            </td>

                            <td>
                                @if (order.Status == "Chờ xác nhận")
                                {
                                    <span class="badge bg-warning text-dark">
                                        @order.Status
                                    </span>
                                }
                                else if (order.Status == "Đã xác nhận")
                                {
                                    <span class="badge bg-info text-dark">
                                        @order.Status
                                    </span>
                                }
                                else if (order.Status == "Đang giao hàng")
                                {
                                    <span class="badge bg-primary">
                                        @order.Status
                                    </span>
                                }
                                else if (order.Status == "Đã giao hàng")
                                {
                                    <span class="badge bg-success">
                                        @order.Status
                                    </span>
                                }
                                else if (order.Status == "Đã hủy")
                                {
                                    <span class="badge bg-danger">
                                        @order.Status
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @order.Status
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
