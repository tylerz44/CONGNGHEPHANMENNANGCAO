@model TechMarket.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";

    bool canCancel = Model.Status == "Chờ xác nhận"
                  || Model.Status == "Đang giao hàng";

    var statusClass = Model.Status switch
    {
        "Chờ xác nhận" => "status-pending",
        "Đã xác nhận" => "status-confirmed",
        "Đang giao hàng" => "status-shipping",
        "Đã giao hàng" => "status-completed",
        "Đã hủy" => "status-cancelled",
        _ => "status-default"
    };
}

<style>
    .order-detail-page {
        background: #F8F9FC;
        min-height: 80vh;
        padding: 40px 0 70px;
    }

    .detail-label {
        color: #B49A70;
        font-size: 12px;
        letter-spacing: 3px;
        font-weight: 700;
    }

    .detail-title {
        color: #0A111D;
        font-size: 30px;
        font-weight: 700;
        margin: 10px 0;
    }

    .detail-description {
        color: #7B8492;
        font-size: 14px;
    }

    .btn-back {
        border: 1px solid #DDE2EA;
        color: #132C4F;
        background: white;
        border-radius: 7px;
        padding: 10px 17px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: .2s;
    }

        .btn-back:hover {
            background: #0A111D;
            color: white;
            border-color: #0A111D;
        }

    .detail-card {
        background: white;
        border: 1px solid #E9ECF2;
        border-radius: 13px;
        margin-top: 22px;
        overflow: hidden;
    }

    .detail-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #EEF0F4;
        color: #0A111D;
        font-size: 16px;
        font-weight: 700;
    }

        .detail-card-header i {
            color: #B49A70;
            margin-right: 9px;
        }

    .detail-card-body {
        padding: 25px 24px;
    }

    .info-label {
        color: #929AA6;
        font-size: 12px;
        margin-bottom: 7px;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .info-value {
        color: #172337;
        font-size: 14px;
        font-weight: 600;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .info-item {
        margin-bottom: 23px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-pending {
        background: #FFF4D9;
        color: #9B6B00;
    }

    .status-confirmed {
        background: #E4F3FA;
        color: #176A91;
    }

    .status-shipping {
        background: #E8EEFF;
        color: #3656A5;
    }

    .status-completed {
        background: #E3F5EA;
        color: #237B45;
    }

    .status-cancelled {
        background: #FCE8E8;
        color: #B42318;
    }

    .status-default {
        background: #EEF0F3;
        color: #596273;
    }

    .payment-method {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #172337;
    }

        .payment-method i {
            color: #B49A70;
            font-size: 17px;
        }

    .order-table {
        margin-bottom: 0;
    }

        .order-table thead th {
            background: #F7F8FA;
            color: #657084;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .5px;
            text-transform: uppercase;
            padding: 15px 12px;
            border-bottom: 1px solid #E9ECF2;
            white-space: nowrap;
        }

        .order-table tbody td {
            padding: 17px 12px;
            color: #394457;
            font-size: 13px;
            border-color: #EEF0F4;
            vertical-align: middle;
        }

    .product-name {
        color: #0A111D;
        font-weight: 700;
        min-width: 130px;
    }

    .product-sku {
        color: #89919E;
        font-size: 12px;
    }

    .product-variant {
        display: inline-block;
        background: #F1F3F7;
        padding: 5px 9px;
        border-radius: 5px;
        color: #344054;
        font-size: 12px;
    }

    .product-price {
        white-space: nowrap;
    }

    .product-total {
        color: #B18B53 !important;
        font-weight: 700;
        white-space: nowrap;
    }

    .order-summary {
        background: #FBFCFE;
        padding: 22px 24px;
        border-top: 1px solid #EEF0F4;
    }

    .total-label {
        color: #596273;
        font-size: 14px;
        font-weight: 600;
    }

    .total-amount {
        color: #B18B53;
        font-size: 24px;
        font-weight: 700;
    }

    .note-box {
        background: #F8F9FC;
        border: 1px solid #E9ECF2;
        border-radius: 8px;
        padding: 14px 16px;
        color: #596273;
        font-size: 13px;
        line-height: 1.6;
    }

    .action-area {
        margin-top: 25px;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-cancel-order {
        background: #B42318;
        color: white;
        border: 1px solid #B42318;
        border-radius: 7px;
        padding: 11px 20px;
        font-size: 13px;
        font-weight: 600;
    }

        .btn-cancel-order:hover {
            background: #8F1C13;
            color: white;
        }

    .order-notice {
        border: none;
        border-radius: 9px;
        font-size: 14px;
        padding: 15px 18px;
    }

    @@media (max-width: 576px) {
        .detail-title {
            font-size: 24px;
        }

        .detail-card-header,
        .detail-card-body {
            padding: 17px;
        }

        .order-summary {
            padding: 18px;
        }

        .action-area {
            justify-content: stretch;
        }

            .action-area form,
            .action-area button {
                width: 100%;
            }
    }
</style>

<div class="order-detail-page">
    <div class="container">

        <!-- TIÊU ĐỀ -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <div class="detail-label">TECHMARKET / ORDER DETAIL</div>
                <h1 class="detail-title">Chi tiết đơn hàng #@Model.Id</h1>
                <p class="detail-description mb-0">
                    Kiểm tra thông tin giao hàng và sản phẩm trong đơn hàng của bạn.
                </p>
            </div>

            <a asp-controller="OrderHistory"
               asp-action="Index"
               class="btn-back">
                <i class="bi bi-arrow-left me-1"></i>
                Quay lại
            </a>
        </div>

        <!-- THÔNG BÁO -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show order-notice">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show order-notice">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        <!-- THÔNG TIN ĐƠN HÀNG -->
        <div class="detail-card">
            <div class="detail-card-header">
                <i class="bi bi-receipt"></i>
                Thông tin đơn hàng
            </div>

            <div class="detail-card-body">
                <div class="row">

                    <div class="col-md-6">
                        <div class="info-item">
                            <div class="info-label">Mã đơn hàng</div>
                            <div class="info-value">#@Model.Id</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-item">
                            <div class="info-label">Ngày đặt hàng</div>
                            <div class="info-value">
                                <i class="bi bi-calendar3 me-1"></i>
                                @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-item">
                            <div class="info-label">Trạng thái đơn hàng</div>
                            <div class="info-value">
                                <span class="status-badge @statusClass">
                                    <i class="bi bi-circle-fill me-2"
                                       style="font-size: 6px;"></i>
                                    @Model.Status
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-item">
                            <div class="info-label">Phương thức thanh toán</div>
                            <div class="info-value payment-method">
                                <i class="bi bi-wallet2"></i>

                                @if (Model.PaymentMethod == "COD")
                                {
                                    <span>Thanh toán khi nhận hàng (COD)</span>
                                }
                                else
                                {
                                    <span>@Model.PaymentMethod</span>
                                }
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- THÔNG TIN NGƯỜI NHẬN -->
        <div class="detail-card">
            <div class="detail-card-header">
                <i class="bi bi-geo-alt"></i>
                Thông tin giao hàng
            </div>

            <div class="detail-card-body">
                <div class="row">

                    <div class="col-md-6">
                        <div class="info-item">
                            <div class="info-label">Người nhận</div>
                            <div class="info-value">
                                <i class="bi bi-person me-1"></i>
                                @Model.ReceiverName
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-item">
                            <div class="info-label">Số điện thoại</div>
                            <div class="info-value">
                                <i class="bi bi-telephone me-1"></i>
                                @Model.Phone
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="info-item mb-0">
                            <div class="info-label">Địa chỉ giao hàng</div>
                            <div class="info-value">
                                <i class="bi bi-house-door me-1"></i>
                                @Model.ShippingAddress
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- DANH SÁCH SẢN PHẨM -->
        <div class="detail-card">
            <div class="detail-card-header">
                <i class="bi bi-bag"></i>
                Sản phẩm trong đơn hàng
                <span class="text-muted fw-normal ms-2"
                      style="font-size: 12px;">
                    (@Model.OrderDetails.Sum(x => x.Quantity) sản phẩm)
                </span>
            </div>

            <div class="table-responsive">
                <table class="table order-table align-middle">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th>SKU</th>
                            <th>Kích thước</th>
                            <th>Màu sắc</th>
                            <th>Đơn giá</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td>
                                    <div class="product-name">
                                        @item.ProductName
                                    </div>
                                </td>

                                <td>
                                    <span class="product-sku">
                                        @item.SKU
                                    </span>
                                </td>

                                <td>
                                    <span class="product-variant">
                                        @item.Size
                                    </span>
                                </td>

                                <td>
                                    <span class="product-variant">
                                        @item.Color
                                    </span>
                                </td>

                                <td class="product-price">
                                    @item.UnitPrice.ToString("N0") đ
                                </td>

                                <td class="text-center">
                                    @item.Quantity
                                </td>

                                <td class="product-total">
                                    @item.TotalPrice.ToString("N0") đ
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- TỔNG TIỀN -->
            <div class="order-summary">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="total-label">
                        Tổng thanh toán
                    </div>

                    <div class="total-amount">
                        @Model.TotalAmount.ToString("N0") đ
                    </div>
                </div>
            </div>
        </div>

        <!-- GHI CHÚ -->
        @if (!string.IsNullOrWhiteSpace(Model.Note))
        {
            <div class="detail-card">
                <div class="detail-card-header">
                    <i class="bi bi-chat-left-text"></i>
                    Ghi chú đơn hàng
                </div>

                <div class="detail-card-body">
                    <div class="note-box">
                        @Model.Note
                    </div>
                </div>
            </div>
        }

        <!-- HÀNH ĐỘNG -->
        <div class="action-area">

            @if (canCancel)
            {
                <form asp-controller="OrderHistory"
                      asp-action="Cancel"
                      asp-route-id="@Model.Id"
                      method="post"
                      onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không?');">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-cancel-order">
                        <i class="bi bi-x-circle me-2"></i>
                        Hủy đơn hàng
                    </button>
                </form>
            }
            else if (Model.Status == "Đã giao hàng" ||
            Model.Status == "Đã hủy")
            {
                <div class="alert alert-secondary order-notice mb-0">
                    <i class="bi bi-info-circle me-2"></i>
                    Đơn hàng này không thể hủy.
                </div>
            }

        </div>

    </div>
</div>
