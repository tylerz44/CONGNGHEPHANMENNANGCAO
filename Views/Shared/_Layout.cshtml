@using TechMarket.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TechMarket</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
        :root {
            --tm-navy: #0A111D;
            --tm-blue: #132C4F;
            --tm-muted: #7B96B4;
            --tm-gold: #D6B98C;
        }

        .tm-navbar {
            background: var(--tm-navy);
            padding: 13px 0;
            border-bottom: 1px solid rgba(255,255,255,.1);
        }

        .tm-brand {
            color: white !important;
            font-size: 23px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .tm-brand i {
            color: var(--tm-gold);
            margin-right: 7px;
        }

        .tm-navbar .nav-link {
            color: #DCE2EA;
            font-size: 13px;
            padding: 10px 12px !important;
            transition: .2s;
        }

        .tm-navbar .nav-link:hover {
            color: var(--tm-gold);
        }

        .tm-navbar .navbar-toggler {
            border-color: rgba(255,255,255,.3);
        }

        .tm-navbar .navbar-toggler:focus {
            box-shadow: none;
        }

        .tm-btn {
            border-radius: 3px;
            font-size: 12px;
            font-weight: 600;
            padding: 8px 12px;
            white-space: nowrap;
        }

        .tm-btn-admin {
            background: #A83232;
            color: white;
            border: 1px solid #A83232;
        }

        .tm-btn-store {
            background: var(--tm-gold);
            color: var(--tm-navy);
            border: 1px solid var(--tm-gold);
        }

        .tm-btn-register-store {
            background: transparent;
            color: #DCE2EA;
            border: 1px solid rgba(255,255,255,.35);
        }

        .tm-btn-register-store:hover {
            background: white;
            color: var(--tm-navy);
        }

        .tm-user {
            display: flex;
            align-items: center;
            gap: 8px;
            color: white;
            font-size: 12px;
            padding: 8px 12px;
            margin-left: 8px;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 3px;
            white-space: nowrap;
        }

        .tm-user i {
            color: var(--tm-gold);
            font-size: 17px;
        }

        .tm-user-name {
            color: var(--tm-gold);
            font-weight: 700;
        }

        .tm-logout {
            border-radius: 3px;
            font-size: 12px;
            padding: 8px 12px;
            white-space: nowrap;
        }

        .tm-footer {
            background: var(--tm-navy);
            color: white;
            padding: 35px 0;
            margin-top: 50px;
        }

        .tm-footer h5 {
            letter-spacing: 2px;
        }

        .tm-footer i {
            color: var(--tm-gold);
        }

        @@media (max-width: 991px) {
            .tm-navbar .navbar-nav {
                padding-top: 10px;
            }

            .tm-user {
                margin: 10px 0;
                width: fit-content;
            }

            .tm-navbar .nav-item {
                margin-bottom: 5px;
            }
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark tm-navbar shadow">
            <div class="container">

                <!-- LOGO -->
                <a class="navbar-brand tm-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="bi bi-shop-window"></i>
                    TECHMARKET
                </a>

                <!-- MOBILE BUTTON -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- MENU LEFT -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>
                                Trang chủ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Product"
                               asp-action="Index">
                                <i class="bi bi-grid me-1"></i>
                                Sản phẩm
                            </a>
                        </li>

                       

                    </ul>

                    <!-- MENU RIGHT -->
                    <ul class="navbar-nav align-items-lg-center">

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <!-- ADMIN -->
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item me-lg-2">
                                    <a class="btn tm-btn tm-btn-admin"
                                       asp-area="Admin"
                                       asp-controller="Dashboard"
                                       asp-action="Index">
                                        <i class="bi bi-speedometer2 me-1"></i>
                                        Quản trị
                                    </a>
                                </li>
                            }

                            <!-- STORE OWNER -->
                            @if (User.IsInRole("StoreOwner"))
                            {
                                <li class="nav-item me-lg-2">
                                    <a class="btn tm-btn tm-btn-store"
                                       asp-area="Store"
                                       asp-controller="Dashboard"
                                       asp-action="Index">
                                        <i class="bi bi-shop me-1"></i>
                                        Quản lý cửa hàng
                                    </a>
                                </li>
                            }

                            <!-- CUSTOMER -->
                            @if (User.IsInRole("Customer"))
                            {
                                <li class="nav-item me-lg-2">
                                    <a class="btn tm-btn tm-btn-register-store"
                                       asp-area=""
                                       asp-controller="StoreRegistration"
                                       asp-action="Create">
                                        <i class="bi bi-shop-window me-1"></i>
                                        Mở cửa hàng
                                    </a>
                                </li>

                                <!-- CART -->
                                <li class="nav-item me-lg-2">
                                    @await Component.InvokeAsync("CartSummary")
                                </li>

                                <!-- ORDER HISTORY -->
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="OrderHistory"
                                       asp-action="Index">
                                        <i class="bi bi-clock-history me-1"></i>
                                        Đơn hàng
                                    </a>
                                </li>
                            }
                            @if (User.Identity?.IsAuthenticated == true
                           && User.IsInRole("Customer"))
                            {
                                <a asp-area=""
                                   asp-controller="ShippingAddress"
                                   asp-action="Index"
                                   class="btn btn-outline-light btn-sm me-2">

                                    <i class="bi bi-geo-alt me-1"></i>
                                    Địa chỉ
                                </a>
                            }

                            <!-- USER NAME -->
                            <li class="nav-item">
                                <div class="tm-user">
                                    <i class="bi bi-person-circle"></i>
                                    <span>
                                        Xin chào,
                                        <span class="tm-user-name">
                                            @(User.Identity?.Name ?? "Người dùng")
                                        </span>
                                    </span>
                                </div>
                            </li>
                           
                            <!-- LOGOUT -->
                            <li class="nav-item ms-lg-2">
                                <form asp-area=""
                                      asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-light tm-logout">
                                        <i class="bi bi-box-arrow-right me-1"></i>
                                        Đăng xuất
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <!-- LOGIN -->
                            <li class="nav-item me-lg-2">
                                <a class="btn btn-outline-light tm-btn"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Đăng nhập
                                </a>
                            </li>

                            <!-- REGISTER -->
                            <li class="nav-item mt-2 mt-lg-0">
                                <a class="btn tm-btn tm-btn-store"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i>
                                    Đăng ký
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="tm-footer text-center">
        <div class="container">

            <h5 class="fw-bold">
                <i class="bi bi-shop-window"></i>
                TECHMARKET
            </h5>

            <p class="mb-2">
                Thời trang hiện đại - Phong cách của bạn
            </p>

            <small class="text-secondary">
                © 2026 TechMarket. All rights reserved.
            </small>

        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
