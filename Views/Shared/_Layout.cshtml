@using TechMarket.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TechMarket</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css"
          asp-append-version="true" />

    <style>
        .tech-navbar {
            background: #151515;
            border-bottom: 2px solid #ffc107;
        }

        .tech-navbar .navbar-brand {
            letter-spacing: 1.5px;
            color: #ffc107;
        }

        .tech-navbar .nav-link {
            color: #e5e5e5;
            transition: .2s;
        }

        .tech-navbar .nav-link:hover {
            color: #ffc107;
        }

        .btn-admin {
            background: #ffc107;
            color: #151515;
            font-weight: 600;
            border: 1px solid #ffc107;
        }

        .btn-admin:hover {
            background: #e0a800;
            color: #151515;
        }

        .tech-footer {
            background: #151515;
            border-top: 2px solid #ffc107;
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark tech-navbar">
            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="bi bi-bag-check-fill me-1"></i>
                    TECHMARKET
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>
                                Trang chủ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Product"
                               asp-action="Index">
                                <i class="bi bi-grid me-1"></i>
                                Sản phẩm
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                Giới thiệu
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                Liên hệ
                            </a>
                        </li>

                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-lg-2">

                        @* Nút dành riêng cho Admin *@
                        @if (User.Identity != null &&
                        User.Identity.IsAuthenticated &&
                        User.IsInRole("Admin"))
                        {
                            <li class="nav-item mb-2 mb-lg-0">
                                <a class="btn btn-admin btn-sm"
                                   asp-area="Admin"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>
                                    Quản trị hệ thống
                                </a>
                            </li>
                        }

                        @* Nút dành cho StoreOwner *@
                        @if (User.Identity != null &&
                        User.Identity.IsAuthenticated &&
                        User.IsInRole("StoreOwner"))
                        {
                            <li class="nav-item mb-2 mb-lg-0">
                                <a class="btn btn-warning btn-sm"
                                   asp-area="Store"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    <i class="bi bi-shop me-1"></i>
                                    Quản lý cửa hàng
                                </a>
                            </li>
                        }

                        @* Chức năng dành cho Customer *@
                        @if (User.Identity != null &&
                        User.Identity.IsAuthenticated &&
                        User.IsInRole("Customer"))
                        {
                            <li class="nav-item">
                                @await Component.InvokeAsync("CartSummary")
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="OrderHistory"
                                   asp-action="Index">
                                    <i class="bi bi-clock-history me-1"></i>
                                    Lịch sử mua hàng
                                </a>
                            </li>
                        }

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <span class="nav-link text-warning">
                                    <i class="bi bi-person-circle me-1"></i>
                                    Xin chào, @User.Identity?.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-area=""
                                      asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">
                                    <button type="submit"
                                            class="btn btn-outline-light btn-sm">
                                        <i class="bi bi-box-arrow-right me-1"></i>
                                        Đăng xuất
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item mb-2 mb-lg-0">
                                <a class="btn btn-outline-light btn-sm"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Đăng nhập
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Đăng ký
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="tech-footer text-white text-center py-4 mt-5">
        <div class="container">
            <h5 class="fw-bold text-warning">
                <i class="bi bi-bag-check-fill me-1"></i>
                TECHMARKET
            </h5>

            <p class="mb-1">
                Thời trang hiện đại - Phong cách của bạn
            </p>

            <small class="text-secondary">
                © 2026 TechMarket. All rights reserved.
            </small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
