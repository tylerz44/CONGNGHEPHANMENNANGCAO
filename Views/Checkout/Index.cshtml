@model TechMarket.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Thanh toán";

    var cartItems = ViewBag.CartItems
        as IEnumerable<TechMarket.Models.CartItem>;

    decimal totalAmount = ViewBag.TotalAmount ?? 0;
}

<div class="container py-5">
    <h2 class="mb-4">Thanh toán đơn hàng</h2>

    <div class="row g-4">
        <!-- Thông tin giao hàng -->
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h5 class="mb-4">Thông tin nhận hàng</h5>

                    <form asp-controller="Checkout"
                          asp-action="PlaceOrder"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="ReceiverName"
                                   class="form-label"></label>
                            <input asp-for="ReceiverName"
                                   class="form-control"
                                   placeholder="Nhập tên người nhận" />
                            <span asp-validation-for="ReceiverName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone"
                                   class="form-label"></label>
                            <input asp-for="Phone"
                                   class="form-control"
                                   placeholder="Nhập số điện thoại" />
                            <span asp-validation-for="Phone"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ShippingAddress"
                                   class="form-label"></label>
                            <textarea asp-for="ShippingAddress"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Nhập địa chỉ giao hàng"></textarea>
                            <span asp-validation-for="ShippingAddress"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Note"
                                   class="form-label"></label>
                            <textarea asp-for="Note"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Ghi chú cho người bán (nếu có)"></textarea>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PaymentMethod"
                                   class="form-label"></label>

                            <select asp-for="PaymentMethod"
                                    class="form-select">
                                <option value="COD">
                                    Thanh toán khi nhận hàng (COD)
                                </option>
                            </select>

                            <span asp-validation-for="PaymentMethod"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Đặt hàng
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Tóm tắt đơn hàng -->
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h5 class="mb-4">Đơn hàng của bạn</h5>

                    @if (cartItems != null)
                    {
                        foreach (var item in cartItems)
                        {
                            if (item.Product != null &&
                            item.ProductVariant != null)
                            {
                                <div class="d-flex justify-content-between
                                            border-bottom py-3">

                                    <div>
                                        <strong>
                                            @item.Product.Name
                                        </strong>

                                        <div class="text-muted small">
                                            SKU: @item.ProductVariant.SKU
                                        </div>

                                        <div class="text-muted small">
                                            Size: @item.ProductVariant.Size
                                            | Màu: @item.ProductVariant.Color
                                        </div>

                                        <div class="text-muted small">
                                            Số lượng: @item.Quantity
                                        </div>
                                    </div>

                                    <div class="text-end">
                                        @((item.Product.Price *
                                            item.Quantity).ToString("N0"))
                                        đ
                                    </div>
                                </div>
                            }
                        }
                    }

                    <div class="d-flex justify-content-between mt-4">
                        <span>Tổng thanh toán</span>

                        <strong class="text-danger fs-5">
                            @totalAmount.ToString("N0") đ
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
