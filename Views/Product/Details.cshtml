@model TechMarket.Models.Product
@using TechMarket.Models

@{
    ViewData["Title"] = "Chi tiết sản phẩm";

    var variants = ViewBag.Variants as List<ProductVariant>
        ?? new List<ProductVariant>();
}

<div class="container mt-4 mb-5">

    <a asp-controller="Product"
       asp-action="Index"
       class="btn btn-outline-secondary mb-4">
        ← Quay lại danh sách sản phẩm
    </a>

    <div class="row">

        <div class="col-md-6 mb-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@Model.Name"
                     class="img-fluid rounded shadow-sm"
                     style="width:100%; max-height:500px; object-fit:contain;" />
            }
            else
            {
                <div class="bg-light rounded text-center p-5">
                    <p class="text-muted mb-0">
                        Sản phẩm chưa có hình ảnh
                    </p>
                </div>
            }
        </div>

        <div class="col-md-6">

            <h2 class="fw-bold mb-3">
                @Model.Name
            </h2>

            <h3 class="text-danger fw-bold mb-4">
                @Model.Price.ToString("N0") đ
            </h3>

            <hr />

            <p>
                <strong>Danh mục:</strong>
                @(Model.Category?.Name ?? "Chưa phân loại")
            </p>

            <p>
                <strong>Tổng tồn kho:</strong>
                <span class="text-success">
                    @Model.Quantity sản phẩm
                </span>
            </p>

            <hr />

            <h5 class="fw-bold">Mô tả sản phẩm</h5>

            <p style="white-space:pre-line;">
                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "Chưa có mô tả cho sản phẩm này."
                    : Model.Description)
            </p>

            <hr />

            <h5 class="fw-bold mb-3">
                Lựa chọn phân loại
            </h5>


            @if (variants.Any())
            {
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form asp-controller="Cart"
                          asp-action="Add"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Kích cỡ và màu sắc
                            </label>

                            <select id="variantSelect"
                                    name="variantId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Chọn kích cỡ và màu sắc --
                                </option>

                                @foreach (var variant in variants)
                                {
                                    <option value="@variant.Id"
                                            data-stock="@variant.Quantity"
                                            data-sku="@variant.SKU">
                                        Size @variant.Size - @variant.Color
                                        (Còn @variant.Quantity)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <strong>Mã SKU:</strong>
                            <span id="selectedSku" class="text-muted">
                                Chưa chọn
                            </span>
                        </div>

                        <div class="mb-3">
                            <strong>Tồn kho biến thể:</strong>
                            <span id="selectedStock" class="text-muted">
                                Chưa chọn
                            </span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Số lượng
                            </label>

                            <input type="number"
                                   id="quantity"
                                   name="quantity"
                                   value="1"
                                   min="1"
                                   class="form-control"
                                   style="width:120px;"
                                   disabled
                                   required />
                        </div>

                        <button type="submit"
                                id="addToCartButton"
                                class="btn btn-primary"
                                disabled>
                            <i class="bi bi-cart-plus"></i>
                            Thêm vào giỏ hàng
                        </button>

                    </form>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-primary">
                        Đăng nhập để mua hàng
                    </a>
                }
            }
            else
            {
                <div class="alert alert-warning">
                    Sản phẩm hiện chưa có biến thể nào đang bán
                    hoặc tất cả biến thể đã hết hàng.
                </div>
            }


            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Tiếp tục mua sắm
            </a>

        </div>
    </div>
</div>


@section Scripts {
    <script>
        const variantSelect =
            document.getElementById("variantSelect");

        const quantityInput =
            document.getElementById("quantity");

        const selectedSku =
            document.getElementById("selectedSku");

        const selectedStock =
            document.getElementById("selectedStock");

        const addToCartButton =
            document.getElementById("addToCartButton");

        if (variantSelect) {
            variantSelect.addEventListener("change", function () {

                const selectedOption =
                    this.options[this.selectedIndex];

                if (!this.value) {
                    quantityInput.value = 1;
                    quantityInput.disabled = true;
                    quantityInput.removeAttribute("max");

                    selectedSku.textContent = "Chưa chọn";
                    selectedStock.textContent = "Chưa chọn";

                    addToCartButton.disabled = true;
                    return;
                }

                const stock = parseInt(
                    selectedOption.dataset.stock
                );

                quantityInput.disabled = false;
                quantityInput.max = stock;
                quantityInput.value = 1;

                selectedSku.textContent =
                    selectedOption.dataset.sku;

                selectedStock.textContent =
                    stock + " sản phẩm";

                addToCartButton.disabled = false;
            });
        }

        if (quantityInput) {
            quantityInput.addEventListener("change", function () {

                const max = parseInt(this.max || "1");
                const value = parseInt(this.value);

                if (isNaN(value) || value < 1) {
                    this.value = 1;
                }
                else if (value > max) {
                    this.value = max;
                }
            });
        }
    </script>
}
