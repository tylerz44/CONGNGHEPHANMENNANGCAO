@model TechMarket.Models.Product
@using TechMarket.Models

@{
    ViewData["Title"] = "Chi tiết sản phẩm";

    var variants = ViewBag.Variants as List<ProductVariant>
        ?? new List<ProductVariant>();

    var availableVariants = variants
        .Where(v => v.IsActive && v.Quantity > 0)
        .ToList();
}

<style>
    :root {
        --detail-navy: #0A111D;
        --detail-blue: #132C4F;
        --detail-muted: #7B96B4;
        --detail-gold: #D6B98C;
        --detail-bg: #F8F9FC;
    }

    .detail-page {
        background: var(--detail-bg);
        min-height: 100vh;
        padding: 35px 0 75px;
    }

    .detail-breadcrumb {
        font-size: 14px;
        color: #8993A2;
        margin-bottom: 25px;
    }

        .detail-breadcrumb a {
            color: var(--detail-blue);
            text-decoration: none;
        }

            .detail-breadcrumb a:hover {
                color: var(--detail-gold);
            }

    .detail-main {
        background: #fff;
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 8px 35px rgba(10, 17, 29, 0.05);
    }

    .detail-image-box {
        background: #F5F6F8;
        border-radius: 14px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 520px;
    }

    .detail-image {
        width: 100%;
        height: 520px;
        object-fit: contain;
        padding: 15px;
        transition: transform .4s ease;
    }

    .detail-image-box:hover .detail-image {
        transform: scale(1.04);
    }

    .detail-image-empty {
        color: #9AA3AE;
        text-align: center;
        padding: 80px 20px;
    }

    .detail-category {
        display: inline-block;
        background: #EEF2F8;
        color: var(--detail-blue);
        padding: 7px 14px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 16px;
    }

    .detail-name {
        color: var(--detail-navy);
        font-size: 32px;
        font-weight: 700;
        line-height: 1.35;
        margin-bottom: 18px;
    }

    .detail-price {
        color: var(--detail-blue);
        font-size: 29px;
        font-weight: 800;
        margin-bottom: 18px;
    }

    .detail-divider {
        border: 0;
        border-top: 1px solid #E9ECF1;
        margin: 24px 0;
    }

    .detail-label {
        color: var(--detail-navy);
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 10px;
    }

    .detail-description {
        color: #687386;
        font-size: 14px;
        line-height: 1.9;
        white-space: pre-line;
    }

    .detail-stock {
        color: #198754;
        font-weight: 600;
    }

    .detail-select {
        border: 1px solid #DDE2EA;
        border-radius: 9px;
        padding: 12px 14px;
        font-size: 14px;
        color: var(--detail-navy);
        box-shadow: none !important;
    }

        .detail-select:focus,
        .detail-quantity:focus {
            border-color: var(--detail-blue);
        }

    .detail-quantity {
        width: 125px;
        border: 1px solid #DDE2EA;
        border-radius: 9px;
        padding: 11px 14px;
        outline: none;
    }

    .detail-add-button {
        width: 100%;
        background: var(--detail-navy);
        color: white;
        border: 1px solid var(--detail-navy);
        border-radius: 9px;
        padding: 15px;
        font-weight: 700;
        letter-spacing: .5px;
        transition: .25s;
    }

        .detail-add-button:hover:not(:disabled) {
            background: var(--detail-blue);
            border-color: var(--detail-blue);
            color: white;
            transform: translateY(-2px);
        }

        .detail-add-button:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

    .detail-back-button {
        display: inline-block;
        color: var(--detail-blue);
        border: 1px solid #DDE2EA;
        border-radius: 9px;
        padding: 12px 20px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: .2s;
    }

        .detail-back-button:hover {
            background: var(--detail-navy);
            color: white;
            border-color: var(--detail-navy);
        }

    .detail-benefits {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-top: 25px;
    }

    .detail-benefit {
        background: #F7F8FA;
        border-radius: 10px;
        padding: 15px 10px;
        text-align: center;
        color: #687386;
        font-size: 12px;
    }

        .detail-benefit i {
            display: block;
            color: var(--detail-blue);
            font-size: 21px;
            margin-bottom: 8px;
        }

    .detail-info-box {
        background: white;
        border-radius: 15px;
        padding: 25px 28px;
        margin-top: 22px;
        box-shadow: 0 5px 25px rgba(10, 17, 29, .035);
    }

    .detail-info-title {
        color: var(--detail-navy);
        font-size: 19px;
        font-weight: 700;
        margin-bottom: 15px;
    }

    @@media (max-width: 767px) {
        .detail-page {
            padding: 20px 0 45px;
        }

        .detail-main {
            padding: 15px;
        }

        .detail-image-box {
            min-height: 330px;
        }

        .detail-image {
            height: 330px;
        }

        .detail-name {
            font-size: 25px;
            margin-top: 25px;
        }

        .detail-price {
            font-size: 25px;
        }

        .detail-benefits {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="detail-page">
    <div class="container">

        <!-- Breadcrumb -->
        <div class="detail-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <span class="mx-2">/</span>
            <a asp-controller="Product" asp-action="Index">Sản phẩm</a>
            <span class="mx-2">/</span>
            <span>@Model.Name</span>
        </div>

        <div class="detail-main">
            <div class="row g-4">

                <!-- Ảnh sản phẩm -->
                <div class="col-lg-6">
                    <div class="detail-image-box">

                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl"
                                 alt="@Model.Name"
                                 class="detail-image" />
                        }
                        else
                        {
                            <div class="detail-image-empty">
                                <i class="bi bi-image fs-1"></i>
                                <p class="mt-3 mb-0">
                                    Sản phẩm chưa có hình ảnh
                                </p>
                            </div>
                        }

                    </div>
                </div>

                <!-- Thông tin sản phẩm -->
                <div class="col-lg-6">

                    <div class="detail-category">
                        @(Model.Category?.Name ?? "Thời trang")
                    </div>

                    <h1 class="detail-name">
                        @Model.Name
                    </h1>

                    <div class="detail-price">
                        @Model.Price.ToString("N0") đ
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span class="detail-stock">
                            Sản phẩm đang được kinh doanh
                        </span>
                    </div>

                    <hr class="detail-divider" />

                    <!-- Mô tả -->
                    <div class="mb-4">
                        <div class="detail-label">
                            MÔ TẢ SẢN PHẨM
                        </div>

                        <p class="detail-description mb-0">
                            @(string.IsNullOrWhiteSpace(Model.Description)
                                ? "Chưa có mô tả cho sản phẩm này."
                                : Model.Description)
                        </p>
                    </div>

                    <hr class="detail-divider" />

                    <!-- Chọn biến thể -->
                    <div class="detail-label">
                        LỰA CHỌN PHÂN LOẠI
                    </div>

                    @if (availableVariants.Any())
                    {
                        @if (User.Identity?.IsAuthenticated == true
                       && User.IsInRole("Customer"))
                        {
                            <form asp-controller="Cart"
                                  asp-action="Add"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <div class="mb-3">
                                    <label class="detail-label">
                                        Kích cỡ và màu sắc
                                    </label>

                                    <select id="variantSelect"
                                            name="variantId"
                                            class="form-select detail-select"
                                            required>

                                        <option value="">
                                            -- Chọn kích cỡ và màu sắc --
                                        </option>

                                        @foreach (var variant in availableVariants)
                                        {
                                            <option value="@variant.Id"
                                                    data-stock="@variant.Quantity"
                                                    data-sku="@variant.SKU">
                                                Size @variant.Size - @variant.Color
                                                (Còn @variant.Quantity)
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-6">
                                        <div class="detail-label">
                                            Mã SKU
                                        </div>
                                        <span id="selectedSku"
                                              class="text-muted small">
                                            Chưa chọn
                                        </span>
                                    </div>

                                    <div class="col-6">
                                        <div class="detail-label">
                                            Tồn kho
                                        </div>
                                        <span id="selectedStock"
                                              class="text-muted small">
                                            Chưa chọn
                                        </span>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="detail-label">
                                        Số lượng
                                    </label>

                                    <input type="number"
                                           id="quantity"
                                           name="quantity"
                                           value="1"
                                           min="1"
                                           class="detail-quantity"
                                           disabled
                                           required />
                                </div>

                                <button type="submit"
                                        id="addToCartButton"
                                        class="detail-add-button"
                                        disabled>
                                    <i class="bi bi-bag-plus me-2"></i>
                                    THÊM VÀO GIỎ HÀNG
                                </button>

                            </form>
                        }
                        else if (User.Identity?.IsAuthenticated != true)
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="detail-add-button text-center d-block text-decoration-none">
                                <i class="bi bi-person me-2"></i>
                                ĐĂNG NHẬP ĐỂ MUA HÀNG
                            </a>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                Tài khoản hiện tại không có quyền mua hàng.
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            Sản phẩm hiện chưa có biến thể nào đang bán
                            hoặc tất cả biến thể đã hết hàng.
                        </div>
                    }

                    <div class="detail-benefits">
                        <div class="detail-benefit">
                            <i class="bi bi-shield-check"></i>
                            Sản phẩm chất lượng
                        </div>

                        <div class="detail-benefit">
                            <i class="bi bi-truck"></i>
                            Giao hàng tận nơi
                        </div>

                        <div class="detail-benefit">
                            <i class="bi bi-headset"></i>
                            Hỗ trợ khách hàng
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Thông tin bổ sung -->
        <div class="detail-info-box">
            <h5 class="detail-info-title">
                <i class="bi bi-info-circle me-2"></i>
                Thông tin sản phẩm
            </h5>

            <div class="row">
                <div class="col-md-6 mb-2">
                    <span class="text-muted">Tên sản phẩm:</span>
                    <strong class="ms-2">@Model.Name</strong>
                </div>

                <div class="col-md-6 mb-2">
                    <span class="text-muted">Danh mục:</span>
                    <strong class="ms-2">
                        @(Model.Category?.Name ?? "Chưa phân loại")
                    </strong>
                </div>

                <div class="col-md-6 mb-2">
                    <span class="text-muted">Tổng tồn kho:</span>
                    <strong class="ms-2">@Model.Quantity sản phẩm</strong>
                </div>

                <div class="col-md-6 mb-2">
                    <span class="text-muted">Số loại biến thể còn hàng:</span>
                    <strong class="ms-2">@availableVariants.Count</strong>
                </div>
            </div>
        </div>

        <!-- Quay lại -->
        <div class="mt-4">
            <a asp-controller="Product"
               asp-action="Index"
               class="detail-back-button">
                <i class="bi bi-arrow-left me-2"></i>
                QUAY LẠI DANH SÁCH SẢN PHẨM
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        const variantSelect = document.getElementById("variantSelect");
        const quantityInput = document.getElementById("quantity");
        const selectedSku = document.getElementById("selectedSku");
        const selectedStock = document.getElementById("selectedStock");
        const addToCartButton = document.getElementById("addToCartButton");

        if (variantSelect) {
            variantSelect.addEventListener("change", function () {
                const option = this.options[this.selectedIndex];

                if (!this.value) {
                    quantityInput.value = 1;
                    quantityInput.disabled = true;
                    quantityInput.removeAttribute("max");

                    selectedSku.textContent = "Chưa chọn";
                    selectedStock.textContent = "Chưa chọn";

                    addToCartButton.disabled = true;
                    return;
                }

                const stock = parseInt(option.dataset.stock, 10);

                selectedSku.textContent = option.dataset.sku || "Không có";
                selectedStock.textContent = stock + " sản phẩm";

                quantityInput.disabled = false;
                quantityInput.max = stock;
                quantityInput.value = 1;

                addToCartButton.disabled = stock <= 0;
            });
        }

        if (quantityInput) {
            quantityInput.addEventListener("input", function () {
                const max = parseInt(this.max || "1", 10);
                let value = parseInt(this.value, 10);

                if (isNaN(value) || value < 1) {
                    value = 1;
                }

                if (value > max) {
                    value = max;
                }

                this.value = value;
            });
        }
    </script>
}
