@model IEnumerable<TechMarket.Models.Product>
@using TechMarket.Models

@{
    ViewData["Title"] = "Bộ sưu tập";

    var products = Model?.ToList() ?? new List<Product>();

    var categories = ViewBag.Categories as IEnumerable<Category>
                     ?? Enumerable.Empty<Category>();

    string keyword = ViewBag.Keyword?.ToString() ?? "";
    string selectedCategory = ViewBag.CategoryId?.ToString() ?? "";
}

<style>
    :root {
        --product-navy: #0A111D;
        --product-blue: #132C4F;
        --product-muted: #7B96B4;
        --product-bg: #F5F7FA;
        --product-border: #E5E9EF;
        --product-text: #202A38;
        --product-gold: #D6B98C;
    }

    body {
        background: var(--product-bg);
        color: var(--product-text);
    }

    .product-page {
        padding-bottom: 80px;
    }

    /* HERO */

    .product-hero {
        background: var(--product-navy);
        color: white;
        padding: 75px 0 70px;
        position: relative;
        overflow: hidden;
    }

        .product-hero::before {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            border: 1px solid rgba(214,185,140,.18);
            border-radius: 50%;
            right: -100px;
            top: -230px;
        }

        .product-hero::after {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border: 1px solid rgba(214,185,140,.12);
            border-radius: 50%;
            right: 40px;
            top: -150px;
        }

    .product-hero-content {
        position: relative;
        z-index: 1;
        max-width: 1250px;
        width: 92%;
        margin: auto;
    }

    .product-eyebrow {
        color: var(--product-gold);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 5px;
        text-transform: uppercase;
        margin-bottom: 18px;
    }

    .product-hero h1 {
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(40px, 6vw, 65px);
        font-weight: 400;
        margin-bottom: 18px;
    }

    .product-hero p {
        color: #B9C2CE;
        font-size: 14px;
        max-width: 540px;
        line-height: 1.9;
        margin: 0;
    }

    .product-hero-line {
        width: 65px;
        height: 2px;
        background: var(--product-gold);
        margin-bottom: 25px;
    }

    /* MAIN */

    .product-container {
        width: 92%;
        max-width: 1250px;
        margin: auto;
    }

    .product-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin: 40px 0 25px;
        flex-wrap: wrap;
    }

    .product-count {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 23px;
        color: var(--product-navy);
    }

        .product-count span {
            color: var(--product-muted);
            font-family: Arial, sans-serif;
            font-size: 12px;
            margin-left: 8px;
        }

    /* FILTER */

    .product-filter {
        background: white;
        border: 1px solid var(--product-border);
        padding: 22px;
        margin-bottom: 35px;
    }

    .filter-title {
        color: var(--product-navy);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 18px;
    }

    .filter-input {
        width: 100%;
        height: 46px;
        border: 1px solid var(--product-border);
        border-radius: 0;
        padding: 0 14px;
        font-size: 13px;
        color: var(--product-navy);
        background: white;
        outline: none;
    }

        .filter-input:focus {
            border-color: var(--product-muted);
            box-shadow: 0 0 0 3px rgba(123,150,180,.1);
        }

    .filter-button {
        height: 46px;
        width: 100%;
        border: 1px solid var(--product-navy);
        background: var(--product-navy);
        color: white;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        transition: .25s;
    }

        .filter-button:hover {
            background: var(--product-blue);
        }

    .reset-filter {
        color: var(--product-muted);
        text-decoration: none;
        font-size: 11px;
        display: inline-block;
        margin-top: 13px;
    }

        .reset-filter:hover {
            color: var(--product-navy);
        }

    /* PRODUCT CARD */

    .product-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 28px 20px;
    }

    .product-card {
        background: white;
        border: 1px solid var(--product-border);
        transition: .3s;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(10,17,29,.09);
        }

    .product-image {
        position: relative;
        overflow: hidden;
        background: #ECEFF3;
        aspect-ratio: 3 / 4;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .5s;
        }

    .product-card:hover .product-image img {
        transform: scale(1.05);
    }

    .product-image-placeholder {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9AA5B1;
        font-size: 13px;
        flex-direction: column;
        gap: 8px;
    }

        .product-image-placeholder i {
            font-size: 35px;
        }

    .product-tag {
        position: absolute;
        top: 13px;
        left: 13px;
        background: var(--product-navy);
        color: white;
        font-size: 9px;
        letter-spacing: 1px;
        padding: 7px 10px;
        text-transform: uppercase;
    }

    .product-info {
        padding: 19px 17px 17px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .product-category {
        color: var(--product-muted);
        font-size: 10px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 9px;
    }

    .product-name {
        color: var(--product-navy);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 18px;
        font-weight: 400;
        line-height: 1.4;
        margin-bottom: 12px;
        min-height: 50px;
    }

    .product-price {
        color: var(--product-blue);
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 17px;
    }

    .product-detail-button {
        display: block;
        width: 100%;
        padding: 12px;
        border: 1px solid var(--product-navy);
        color: var(--product-navy);
        background: white;
        text-align: center;
        text-decoration: none;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        transition: .25s;
        margin-top: auto;
    }

        .product-detail-button:hover {
            background: var(--product-navy);
            color: white;
        }

    /* EMPTY */

    .product-empty {
        background: white;
        border: 1px solid var(--product-border);
        text-align: center;
        padding: 65px 20px;
    }

        .product-empty i {
            color: var(--product-muted);
            font-size: 42px;
            margin-bottom: 15px;
        }

        .product-empty h4 {
            font-family: Georgia, "Times New Roman", serif;
            color: var(--product-navy);
            font-weight: 400;
            font-size: 24px;
        }

        .product-empty p {
            color: #87909C;
            font-size: 13px;
        }

        .product-empty a {
            display: inline-block;
            background: var(--product-navy);
            color: white;
            text-decoration: none;
            padding: 12px 22px;
            font-size: 11px;
            letter-spacing: 1px;
            margin-top: 10px;
        }

    /* RESPONSIVE */

    @@media (max-width: 992px) {
        .product-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .product-hero {
            padding: 55px 0;
        }

        .product-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .product-info {
            padding: 14px 12px;
        }

        .product-name {
            font-size: 16px;
        }
    }

    @@media (max-width: 420px) {
        .product-grid {
            gap: 12px;
        }

        .product-name {
            font-size: 15px;
        }

        .product-price {
            font-size: 14px;
        }
    }
</style>

<div class="product-page">

    <!-- HERO -->
    <section class="product-hero">
        <div class="product-hero-content">

            <div class="product-eyebrow">
                TECHMARKET / COLLECTION
            </div>

            <div class="product-hero-line"></div>

            <h1>Discover Your<br />Own Style.</h1>

            <p>
                Khám phá bộ sưu tập thời trang mới nhất tại TechMarket.
                Tìm kiếm phong cách riêng và lựa chọn những sản phẩm phù hợp với bạn.
            </p>

        </div>
    </section>

    <div class="product-container">

        <!-- TOOLBAR -->
        <div class="product-toolbar">

            <div class="product-count">
                Tất cả sản phẩm
                <span>@products.Count() sản phẩm</span>
            </div>

        </div>

        <!-- FILTER -->
        <div class="product-filter">

            <div class="filter-title">
                <i class="bi bi-sliders me-2"></i>
                Tìm kiếm và lọc sản phẩm
            </div>

            <form asp-controller="Product"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <div class="col-lg-6">
                        <input type="text"
                               name="keyword"
                               value="@keyword"
                               class="filter-input"
                               placeholder="Nhập tên sản phẩm bạn muốn tìm..." />
                    </div>

                    <div class="col-lg-4">
                        <select name="categoryId" class="filter-input">
                            <option value="">Tất cả danh mục</option>

                            @foreach (var category in categories)
                            {
                                if (selectedCategory == category.Id.ToString())
                                {
                                    <option value="@category.Id" selected>
                                        @category.Name
                                    </option>
                                }
                                else
                                {
                                    <option value="@category.Id">
                                        @category.Name
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-lg-2">
                        <button type="submit" class="filter-button">
                            <i class="bi bi-search me-1"></i>
                            Tìm kiếm
                        </button>
                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(keyword) ||
                !string.IsNullOrWhiteSpace(selectedCategory))
                {
                    <a asp-controller="Product"
                       asp-action="Index"
                       class="reset-filter">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Xóa bộ lọc
                    </a>
                }

            </form>
        </div>

        <!-- PRODUCT LIST -->
        @if (products.Any())
        {
            <div class="product-grid">

                @foreach (var item in products)
                {
                    <div class="product-card">

                        <div class="product-image">

                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl"
                                     alt="@item.Name"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="product-image-placeholder">
                                    <i class="bi bi-image"></i>
                                    Chưa có hình ảnh
                                </div>
                            }

                            <span class="product-tag">
                                TECHMARKET
                            </span>

                        </div>

                        <div class="product-info">

                            <div class="product-category">
                                @(item.Category?.Name ?? "Thời trang")
                            </div>

                            <h5 class="product-name">
                                @item.Name
                            </h5>

                            <div class="product-price">
                                @item.Price.ToString("N0") ₫
                            </div>

                            <a asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               class="product-detail-button">
                                Xem chi tiết
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="product-empty">

                <i class="bi bi-search"></i>

                <h4>Không tìm thấy sản phẩm</h4>

                <p>
                    Không có sản phẩm phù hợp với thông tin tìm kiếm của bạn.
                    Vui lòng thử từ khóa hoặc danh mục khác.
                </p>

                <a asp-controller="Product"
                   asp-action="Index">
                    Xem tất cả sản phẩm
                </a>

            </div>
        }

    </div>
</div>
