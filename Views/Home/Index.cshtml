@model IEnumerable<TechMarket.Models.Product>
@using TechMarket.Models

@{
    ViewData["Title"] = "TechMarket - Luxury Fashion";

    var products = Model?.ToList() ?? new List<Product>();

    var categories = ViewBag.Categories as List<Category>
                     ?? new List<Category>();

    var categoryImages = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["Áo thun nam"] = "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=900",
                ["Áo thun nữ"] = "https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?w=900",
                ["Hoodie"] = "https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=900",
                ["Quần"] = "https://images.unsplash.com/photo-1542272604-787c3835535d?w=900"
            };
}

<style>
    :root {
        --lumen-navy: #0A111D;
        --lumen-blue: #132C4F;
        --lumen-muted: #7B96B4;
        --lumen-light: #F9F9FE;
        --lumen-white: #FFFFFF;
        --lumen-text: #202A38;
        --lumen-gray: #77808C;
        --lumen-border: #E5E9EF;
    }

    body {
        background: var(--lumen-light);
        color: var(--lumen-text);
        font-family: Arial, Helvetica, sans-serif;
    }

    .lumen-home {
        overflow: hidden;
    }

    .lumen-container {
        width: min(1320px, 92%);
        margin: auto;
    }

    /* HERO */

    .lumen-hero {
        position: relative;
        min-height: 650px;
        background: var(--lumen-navy);
        color: white;
        display: flex;
        align-items: center;
        overflow: hidden;
    }

    .lumen-hero-image {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(90deg, rgba(5, 12, 23, .94) 0%, rgba(5, 12, 23, .68) 43%, rgba(5, 12, 23, .12) 100%), url('https://images.unsplash.com/photo-1539109136881-3be0616acf4b?w=2000');
        background-size: cover;
        background-position: center 35%;
        transform: scale(1.02);
    }

    .lumen-hero-content {
        position: relative;
        z-index: 2;
        max-width: 680px;
        padding: 100px 0;
    }

    .lumen-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: #B7C9DD;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 4px;
        text-transform: uppercase;
        margin-bottom: 25px;
    }

        .lumen-eyebrow::before {
            content: "";
            width: 35px;
            height: 1px;
            background: #B7C9DD;
        }

    .lumen-hero h1 {
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(48px, 7vw, 88px);
        font-weight: 400;
        line-height: 1.02;
        letter-spacing: -2px;
        margin: 0 0 25px;
    }

        .lumen-hero h1 span {
            color: #A9BED6;
            font-style: italic;
        }

    .lumen-hero-description {
        max-width: 450px;
        color: #D1D9E3;
        font-size: 15px;
        line-height: 1.9;
        margin-bottom: 35px;
    }

    .lumen-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        padding: 16px 27px;
        background: white;
        color: var(--lumen-navy);
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        transition: .3s;
    }

        .lumen-button:hover {
            background: #A9BED6;
            color: var(--lumen-navy);
            transform: translateY(-3px);
        }

    .lumen-hero-number {
        position: absolute;
        right: 4%;
        bottom: 45px;
        z-index: 2;
        color: rgba(255,255,255,.7);
        font-size: 11px;
        letter-spacing: 3px;
    }

    /* INTRO */

    .lumen-intro {
        padding: 100px 0 85px;
        text-align: center;
    }

    .lumen-section-label {
        color: var(--lumen-muted);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 4px;
        text-transform: uppercase;
        margin-bottom: 18px;
    }

    .lumen-intro h2,
    .lumen-section-heading h2 {
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(34px, 4vw, 52px);
        font-weight: 400;
        color: var(--lumen-navy);
        line-height: 1.2;
    }

        .lumen-intro h2 span {
            color: var(--lumen-muted);
            font-style: italic;
        }

    .lumen-intro p {
        max-width: 620px;
        margin: 20px auto 0;
        color: var(--lumen-gray);
        font-size: 14px;
        line-height: 1.9;
    }

    /* CATEGORY */

    .lumen-categories {
        padding: 20px 0 100px;
    }

    .lumen-section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 35px;
    }

        .lumen-section-heading h2 {
            margin: 0;
        }

    .lumen-text-link {
        color: var(--lumen-blue);
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        border-bottom: 1px solid var(--lumen-muted);
        padding-bottom: 7px;
        white-space: nowrap;
    }

        .lumen-text-link:hover {
            color: var(--lumen-muted);
        }

    .lumen-category-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .lumen-category-card {
        position: relative;
        height: 390px;
        display: block;
        overflow: hidden;
        text-decoration: none;
        background: #DCE2E9;
    }

        .lumen-category-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .7s ease;
        }

        .lumen-category-card:hover img {
            transform: scale(1.08);
        }

    .lumen-category-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(0deg, rgba(5, 12, 23, .8), transparent 65%);
        display: flex;
        flex-direction: column;
        justify-content: end;
        padding: 25px;
        color: white;
    }

    .lumen-category-number {
        font-size: 10px;
        letter-spacing: 2px;
        color: #D3DFEC;
        margin-bottom: 9px;
    }

    .lumen-category-name {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 27px;
        font-weight: 400;
    }

    .lumen-category-arrow {
        position: absolute;
        right: 22px;
        bottom: 28px;
        font-size: 22px;
        transition: transform .3s;
    }

    .lumen-category-card:hover .lumen-category-arrow {
        transform: translateX(6px);
    }

    /* PRODUCTS */

    .lumen-products {
        background: #F0F2F6;
        padding: 95px 0 105px;
    }

    .lumen-product-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
    }

    .lumen-product-card {
        background: white;
        transition: transform .3s, box-shadow .3s;
    }

        .lumen-product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(10, 17, 29, .08);
        }

    .lumen-product-image {
        position: relative;
        height: 320px;
        overflow: hidden;
        background: #E8EBF0;
    }

        .lumen-product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .6s;
        }

    .lumen-product-card:hover .lumen-product-image img {
        transform: scale(1.06);
    }

    .lumen-product-tag {
        position: absolute;
        top: 15px;
        left: 15px;
        background: var(--lumen-navy);
        color: white;
        padding: 7px 11px;
        font-size: 9px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .lumen-product-info {
        padding: 20px 18px 22px;
    }

    .lumen-product-category {
        color: var(--lumen-muted);
        font-size: 10px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .lumen-product-name {
        display: block;
        color: var(--lumen-navy);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 19px;
        text-decoration: none;
        margin-bottom: 12px;
    }

        .lumen-product-name:hover {
            color: var(--lumen-muted);
        }

    .lumen-product-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .lumen-product-price {
        color: var(--lumen-blue);
        font-size: 15px;
        font-weight: 700;
    }

    .lumen-product-view {
        color: var(--lumen-gray);
        font-size: 10px;
        letter-spacing: 1px;
        text-transform: uppercase;
        text-decoration: none;
    }

        .lumen-product-view:hover {
            color: var(--lumen-blue);
        }

    .lumen-empty {
        grid-column: 1 / -1;
        text-align: center;
        padding: 60px 20px;
        background: white;
        color: var(--lumen-gray);
    }

    /* CAMPAIGN */

    .lumen-campaign {
        position: relative;
        min-height: 470px;
        display: flex;
        align-items: center;
        background: linear-gradient(90deg, rgba(7, 15, 28, .95), rgba(7, 15, 28, .4)), url('https://images.unsplash.com/photo-1525507119028-ed4c629a60a3?w=1800');
        background-size: cover;
        background-position: center;
        color: white;
    }

    .lumen-campaign-content {
        max-width: 600px;
        padding: 80px 0;
    }

    .lumen-campaign h2 {
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(38px, 5vw, 62px);
        font-weight: 400;
        line-height: 1.15;
        margin: 15px 0 20px;
    }

    .lumen-campaign p {
        color: #D5DDE7;
        font-size: 14px;
        line-height: 1.9;
        margin-bottom: 30px;
    }

    /* BENEFITS */

    .lumen-benefits {
        padding: 85px 0;
        background: white;
    }

    .lumen-benefit-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 35px;
    }

    .lumen-benefit {
        text-align: center;
        padding: 15px 25px;
    }

    .lumen-benefit-icon {
        width: 55px;
        height: 55px;
        border: 1px solid var(--lumen-border);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        color: var(--lumen-blue);
        font-size: 22px;
    }

    .lumen-benefit h5 {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 21px;
        font-weight: 400;
        color: var(--lumen-navy);
        margin-bottom: 10px;
    }

    .lumen-benefit p {
        color: var(--lumen-gray);
        font-size: 12px;
        line-height: 1.8;
        margin: 0;
    }

    /* RESPONSIVE */

    @@media (max-width: 992px) {
        .lumen-category-grid,
        .lumen-product-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .lumen-category-card {
            height: 340px;
        }

        .lumen-product-image {
            height: 300px;
        }
    }

    @@media (max-width: 576px) {
        .lumen-hero {
            min-height: 570px;
        }

        .lumen-hero-content {
            padding: 80px 0;
        }

        .lumen-hero h1 {
            font-size: 48px;
        }

        .lumen-intro {
            padding: 70px 0 55px;
        }

        .lumen-section-heading {
            align-items: start;
            flex-direction: column;
        }

        .lumen-category-grid,
        .lumen-product-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .lumen-category-card {
            height: 250px;
        }

        .lumen-category-overlay {
            padding: 14px;
        }

        .lumen-category-name {
            font-size: 19px;
        }

        .lumen-product-image {
            height: 210px;
        }

        .lumen-product-info {
            padding: 13px 11px 15px;
        }

        .lumen-product-name {
            font-size: 16px;
        }

        .lumen-product-price {
            font-size: 13px;
        }

        .lumen-product-view {
            font-size: 9px;
        }

        .lumen-campaign {
            min-height: 400px;
        }

        .lumen-benefit-grid {
            grid-template-columns: 1fr;
            gap: 25px;
        }
    }
</style>

<div class="lumen-home">

    <!-- HERO BANNER -->
    <section class="lumen-hero">
        <div class="lumen-hero-image"></div>

        <div class="lumen-container">
            <div class="lumen-hero-content">
                <div class="lumen-eyebrow">
                    The New Fashion Experience
                </div>

                <h1>
                    Discover<br />
                    Your <span>Own</span><br />
                    Style.
                </h1>

                <p class="lumen-hero-description">
                    Khám phá phong cách thời trang dành riêng cho bạn.
                    Những thiết kế hiện đại, tinh tế và chất lượng
                    giúp bạn tự tin thể hiện cá tính mỗi ngày.
                </p>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="lumen-button">
                    Khám phá bộ sưu tập
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>
        </div>

        <div class="lumen-hero-number">
            TECHMARKET — EST. 2026
        </div>
    </section>

    <!-- INTRODUCTION -->
    <section class="lumen-intro">
        <div class="lumen-container">
            <div class="lumen-section-label">
                About TechMarket
            </div>

            <h2>
                Fashion is an art.<br />
                <span>Make it your own.</span>
            </h2>

            <p>
                TechMarket mang đến trải nghiệm mua sắm thời trang
                hiện đại với những sản phẩm được tuyển chọn kỹ lưỡng.
                Chúng tôi tin rằng phong cách không chỉ nằm ở trang phục,
                mà còn là cách bạn thể hiện chính mình.
            </p>
        </div>
    </section>

    <!-- CATEGORIES -->
    <section class="lumen-categories">
        <div class="lumen-container">

            <div class="lumen-section-heading">
                <div>
                    <div class="lumen-section-label">
                        Explore Our Collections
                    </div>

                    <h2>Shop by Category</h2>
                </div>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="lumen-text-link">
                    View All Collections
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>

            <div class="lumen-category-grid">
                @if (categories.Any())
                {
                    @for (int i = 0; i < categories.Count; i++)
                    {
                        var category = categories[i];
                        var image = categoryImages.TryGetValue(category.Name, out var categoryImage)
                        ? categoryImage
                        : "https://images.unsplash.com/photo-1529139574466-a303027c1d8b?w=900";

                        <a asp-controller="Product"
                           asp-action="Index"
                           class="lumen-category-card">

                            <img src="@image"
                                 alt="@category.Name"
                                 loading="lazy" />

                            <div class="lumen-category-overlay">
                                <span class="lumen-category-number">
                                    COLLECTION @(i + 1).ToString("00")
                                </span>

                                <span class="lumen-category-name">
                                    @category.Name
                                </span>

                                <span class="lumen-category-arrow">
                                    <i class="bi bi-arrow-up-right"></i>
                                </span>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div class="lumen-empty">
                        Hiện chưa có danh mục sản phẩm.
                    </div>
                }
            </div>

        </div>
    </section>

    <!-- NEW ARRIVALS -->
    <section class="lumen-products">
        <div class="lumen-container">

            <div class="lumen-section-heading">
                <div>
                    <div class="lumen-section-label">
                        Carefully Selected For You
                    </div>

                    <h2>New Arrivals</h2>
                </div>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="lumen-text-link">
                    Explore All Products
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>

            <div class="lumen-product-grid">
                @if (products.Any())
                {
                    @foreach (var product in products)
                    {
                        <div class="lumen-product-card">

                            <div class="lumen-product-image">
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.Name"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <img src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?w=700"
                                         alt="@product.Name"
                                         loading="lazy" />
                                }

                                <span class="lumen-product-tag">
                                    New Arrival
                                </span>
                            </div>

                            <div class="lumen-product-info">

                                <div class="lumen-product-category">
                                    @(product.Category?.Name ?? "Fashion")
                                </div>

                                <a asp-controller="Product"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="lumen-product-name">
                                    @product.Name
                                </a>

                                <div class="lumen-product-bottom">
                                    <span class="lumen-product-price">
                                        @product.Price.ToString("N0") ₫
                                    </span>

                                    <a asp-controller="Product"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="lumen-product-view">
                                        View Details
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                </div>

                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="lumen-empty">
                        <i class="bi bi-bag fs-2 d-block mb-3"></i>
                        Hiện chưa có sản phẩm để hiển thị.
                    </div>
                }
            </div>

        </div>
    </section>

    <!-- CAMPAIGN -->
    <section class="lumen-campaign">
        <div class="lumen-container">
            <div class="lumen-campaign-content">

                <div class="lumen-eyebrow">
                    The Art Of Dressing
                </div>

                <h2>
                    Elegance is<br />
                    in every detail.
                </h2>

                <p>
                    Không cần chạy theo xu hướng.
                    Hãy tìm kiếm những món đồ phù hợp với bạn
                    và tạo nên phong cách không thể nhầm lẫn.
                </p>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="lumen-button">
                    Shop The Collection
                    <i class="bi bi-arrow-up-right"></i>
                </a>

            </div>
        </div>
    </section>

    <!-- BENEFITS -->
    <section class="lumen-benefits">
        <div class="lumen-container">

            <div class="lumen-benefit-grid">

                <div class="lumen-benefit">
                    <div class="lumen-benefit-icon">
                        <i class="bi bi-gem"></i>
                    </div>

                    <h5>Curated Quality</h5>

                    <p>
                        Sản phẩm được lựa chọn kỹ lưỡng,
                        chú trọng chất lượng và phong cách.
                    </p>
                </div>

                <div class="lumen-benefit">
                    <div class="lumen-benefit-icon">
                        <i class="bi bi-truck"></i>
                    </div>

                    <h5>Reliable Delivery</h5>

                    <p>
                        Theo dõi đơn hàng dễ dàng,
                        trải nghiệm mua sắm thuận tiện.
                    </p>
                </div>

                <div class="lumen-benefit">
                    <div class="lumen-benefit-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <h5>Secure Shopping</h5>

                    <p>
                        Thông tin tài khoản và đơn hàng
                        được quản lý an toàn.
                    </p>
                </div>

            </div>
        </div>
    </section>

</div>
