@{
    ViewData["Title"] = "Trang chủ";
}

<!-- BANNER -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <span class="badge bg-warning text-dark mb-3">
                    NEW COLLECTION 2026
                </span>

                <h1 class="display-4 fw-bold">
                    PHONG CÁCH<br />
                    LÀ CHÍNH BẠN
                </h1>

                <p class="lead mt-3">
                    Khám phá bộ sưu tập thời trang mới nhất
                    tại TechMarket.
                </p>

                <a href="#products"
                   class="btn btn-warning btn-lg mt-3">
                    MUA SẮM NGAY
                </a>
            </div>

            <div class="col-md-6 text-center">
                <img src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?w=900"
                     class="img-fluid hero-image"
                     alt="Bộ sưu tập thời trang" />
            </div>
        </div>
    </div>
</section>

<!-- DANH MỤC -->
<section class="container py-5">

    <h2 class="section-title text-center mb-4">
        DANH MỤC SẢN PHẨM
    </h2>

    <div class="row g-4">

        <div class="col-6 col-md-3">
            <div class="category-card">
                <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=500"
                     alt="Áo thun" />
                <h5>Áo thun</h5>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="category-card">
                <img src="https://images.unsplash.com/photo-1591047139829-d91aecb6caea?w=500"
                     alt="Áo khoác" />
                <h5>Áo khoác</h5>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="category-card">
                <img src="https://images.unsplash.com/photo-1542272604-787c3835535d?w=500"
                     alt="Quần jeans" />
                <h5>Quần jeans</h5>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="category-card">
                <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?w=500"
                     alt="Thời trang nữ" />
                <h5>Thời trang nữ</h5>
            </div>
        </div>

    </div>
</section>

<!-- SẢN PHẨM NỔI BẬT -->
<section class="container py-5" id="products">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="section-title mb-0">
            SẢN PHẨM NỔI BẬT
        </h2>

        <a href="#" class="text-dark">
            Xem tất cả →
        </a>
    </div>

    <div class="row g-4">

        <!-- PRODUCT 1 -->
        <div class="col-6 col-md-3">
            <div class="product-card">
                <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=600"
                     alt="Áo thun basic" />

                <div class="p-3">
                    <h6>Áo thun Basic</h6>
                    <p class="text-danger fw-bold">199.000đ</p>
                    <button class="btn btn-dark w-100" disabled>
                        Xem sản phẩm
                    </button>
                </div>
            </div>
        </div>

        <!-- PRODUCT 2 -->
        <div class="col-6 col-md-3">
            <div class="product-card">
                <img src="https://images.unsplash.com/photo-1551028719-00167b16eac5?w=600"
                     alt="Áo khoác thời trang" />

                <div class="p-3">
                    <h6>Áo khoác thời trang</h6>
                    <p class="text-danger fw-bold">450.000đ</p>
                    <button class="btn btn-dark w-100" disabled>
                        Xem sản phẩm
                    </button>
                </div>
            </div>
        </div>

        <!-- PRODUCT 3 -->
        <div class="col-6 col-md-3">
            <div class="product-card">
                <img src="https://images.unsplash.com/photo-1542272604-787c3835535d?w=600"
                     alt="Quần jeans" />

                <div class="p-3">
                    <h6>Quần Jeans</h6>
                    <p class="text-danger fw-bold">350.000đ</p>
                    <button class="btn btn-dark w-100" disabled>
                        Xem sản phẩm
                    </button>
                </div>
            </div>
        </div>

        <!-- PRODUCT 4 -->
        <div class="col-6 col-md-3">
            <div class="product-card">
                <img src="https://images.unsplash.com/photo-1503341504253-dff4815485f1?w=600"
                     alt="Áo thời trang nữ" />

                <div class="p-3">
                    <h6>Áo thời trang nữ</h6>
                    <p class="text-danger fw-bold">280.000đ</p>
                    <button class="btn btn-dark w-100" disabled>
                        Xem sản phẩm
                    </button>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- BANNER KHUYẾN MÃI -->
<section class="promotion-section">
    <div class="container text-center">
        <h2>ƯU ĐÃI ĐẶC BIỆT</h2>

        <h3 class="display-5 fw-bold">
            GIẢM GIÁ ĐẾN 30%
        </h3>

        <p>
            Cùng TechMarket cập nhật phong cách thời trang mới.
        </p>

        <a href="#products" class="btn btn-warning btn-lg">
            KHÁM PHÁ NGAY
        </a>
    </div>
</section>
