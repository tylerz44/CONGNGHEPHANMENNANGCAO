@model TechMarket.ViewModels.StoreRegistrationViewModel

@{
    ViewData["Title"] = "Đăng ký mở cửa hàng";
}

<div class="container mt-5 mb-5">
    <div class="card shadow p-4 mx-auto" style="max-width: 650px">

        <h2 class="text-center mb-4">
            ĐĂNG KÝ MỞ CỬA HÀNG
        </h2>

        <p class="text-muted text-center">
            Đăng ký trở thành đối tác bán hàng trên TechMarket.
        </p>

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="StoreName"
                       class="form-label">
                    Tên cửa hàng
                </label>

                <input asp-for="StoreName"
                       class="form-control"
                       placeholder="Nhập tên cửa hàng" />

                <span asp-validation-for="StoreName"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Description"
                       class="form-label">
                    Mô tả cửa hàng
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          placeholder="Giới thiệu cửa hàng">
                </textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Address"
                       class="form-label">
                    Địa chỉ
                </label>

                <input asp-for="Address"
                       class="form-control"
                       placeholder="Nhập địa chỉ cửa hàng" />

                <span asp-validation-for="Address"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone"
                       class="form-label">
                    Số điện thoại
                </label>

                <input asp-for="Phone"
                       class="form-control"
                       placeholder="Nhập số điện thoại" />

                <span asp-validation-for="Phone"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="btn btn-primary w-100">
                Gửi yêu cầu đăng ký
            </button>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary w-100 mt-2">
                Quay lại
            </a>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
