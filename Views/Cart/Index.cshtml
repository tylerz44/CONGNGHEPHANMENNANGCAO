@model TechMarket.Models.Cart

@{
    ViewData["Title"] = "Giỏ hàng";
    decimal total = 0;
}

<div class="container mt-4 mb-5">

    <h2 class="mb-4">
        <i class="bi bi-cart3"></i> Giỏ hàng của tôi
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model.CartItems == null || !Model.CartItems.Any())
    {
        <div class="text-center p-5 border rounded">
            <h4>Giỏ hàng đang trống</h4>

            <p class="text-muted">
                Hãy chọn những sản phẩm yêu thích của bạn.
            </p>

            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-primary">
                Tiếp tục mua sắm
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Đơn giá</th>
                        <th style="width:200px;">Số lượng</th>
                        <th>Thành tiền</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.CartItems)
                    {
                        if (item.Product == null ||
                        item.ProductVariant == null)
                        {
                            continue;
                        }

                        var product = item.Product;
                        var variant = item.ProductVariant;

                        var subtotal = product.Price * item.Quantity;

                        total += subtotal;

                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">

                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl"
                                             alt="@product.Name"
                                             style="width:80px;height:80px;object-fit:cover;"
                                             class="rounded" />
                                    }

                                    <div>
                                        <strong>@product.Name</strong>

                                        <div class="text-muted small">
                                            SKU: @variant.SKU
                                        </div>

                                        <div class="text-muted small">
                                            Size: @variant.Size
                                        </div>

                                        <div class="text-muted small">
                                            Màu: @variant.Color
                                        </div>

                                        <div class="text-muted small">
                                            Tồn kho: @variant.Quantity
                                        </div>
                                    </div>

                                </div>
                            </td>

                            <td>
                                @product.Price.ToString("N0") đ
                            </td>

                            <td>
                                <form asp-controller="Cart"
                                      asp-action="UpdateQuantity"
                                      method="post"
                                      class="d-flex gap-2">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <input type="number"
                                           name="quantity"
                                           value="@item.Quantity"
                                           min="1"
                                           max="@variant.Quantity"
                                           class="form-control"
                                           style="width:85px;"
                                           required />

                                    <button type="submit"
                                            class="btn btn-outline-primary"
                                            title="Cập nhật">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>

                                </form>
                            </td>

                            <td class="fw-bold text-danger">
                                @subtotal.ToString("N0") đ
                            </td>

                            <td>
                                <form asp-controller="Cart"
                                      asp-action="Remove"
                                      method="post"
                                      onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                        Xóa
                                    </button>

                                </form>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="row justify-content-end">

            <div class="col-md-5 col-lg-4">

                <div class="card shadow-sm">

                    <div class="card-body">

                        <h5 class="card-title">
                            Tổng đơn hàng
                        </h5>

                        <div class="d-flex justify-content-between mb-3">

                            <span>Tổng tiền:</span>

                            <strong class="text-danger fs-5">
                                @total.ToString("N0") đ
                            </strong>

                        </div>

                        <a asp-controller="Product"
                           asp-action="Index"
                           class="btn btn-outline-secondary w-100 mb-2">
                            Tiếp tục mua sắm
                        </a>
                        <a asp-controller="Checkout"
                           asp-action="Index"
                           class="btn btn-primary w-100">
                            <i class="bi bi-credit-card"></i>
                            Tiến hành thanh toán
                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

</div>
